---
interface Props {
  title: string;
  subtitle: string;
  id?: string;
}

const { title, subtitle, id = "page-title" } = Astro.props;
---

<section class="page-hero" aria-labelledby={id}>
  <h1 id={id}>{title}</h1>
  <p>{subtitle}</p>
</section>

<style>
  .page-hero {
    max-width: 1120px;
    margin: 0 auto;
    padding: clamp(48px, 8vw, 88px) 20px 28px;
  }

  .page-hero h1 {
    color: var(--text-strong);
    font-size: clamp(2.5rem, 8vw, 5.25rem);
    font-weight: 700;
    letter-spacing: -0.08em;
    line-height: 0.95;
  }

  .page-hero p {
    max-width: 680px;
    margin-top: var(--space-4);
    color: var(--text-muted);
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.55;
  }
</style>
