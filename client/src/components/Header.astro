---
import GitHubLink from "./GitHubLink.astro";
import ThemePicker from "./ThemePicker.astro";
import { TABS } from "../constants";

import type { TabValue } from "../types";

interface Props {
  activeNav: TabValue;
}

const { activeNav } = Astro.props;
---

<header class="site-header" data-site-header>
  <a
    class:list={["brand-link", activeNav === "calculate" && "is-active"]}
    data-nav-link
    href="/"
  >
    <span class="brand-mark" aria-hidden="true">
      <svg
        height="20"
        viewBox="0 0 20 20"
        width="20"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M3.5 3.5h13v3h-5v10h-3v-10h-5v-3Z"
          fill="currentColor"
        />
      </svg>
    </span>
    <span class="brand-name">TOB-L</span>
  </a>

  <nav class="primary-nav desktop-nav" aria-label="Primary">
    {TABS.map((tab) => (
      <a
        class:list={["nav-link", activeNav === tab.value && "is-active"]}
        data-nav-link
        href={tab.href}
        aria-current={activeNav === tab.value ? "page" : undefined}
      >
        {tab.label}
      </a>
    ))}
  </nav>

  <div class="header-actions desktop-actions" aria-label="Header actions">
    <div class="action-divider" aria-hidden="true"></div>
    <ThemePicker id="desktop-theme-menu" />
    <GitHubLink />
  </div>

  <button
    class="menu-trigger"
    type="button"
    aria-label="Open navigation menu"
    aria-expanded="false"
    aria-controls="site-menu"
    data-menu-trigger
  >
    <span class="hamburger-icon" aria-hidden="true">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </span>
  </button>

  <div class="menu-backdrop" data-menu-backdrop></div>

  <aside
    id="site-menu"
    class="menu-panel"
    aria-label="Primary navigation"
    tabindex="-1"
    data-menu-panel
    inert
  >
    <div class="menu-content">
      <nav class="primary-nav mobile-nav" aria-label="Primary">
        {TABS.map((tab) => (
          <a
            class:list={["nav-link", activeNav === tab.value && "is-active"]}
            data-nav-link
            data-menu-link
            href={tab.href}
            aria-current={activeNav === tab.value ? "page" : undefined}
          >
            {tab.label}
          </a>
        ))}
      </nav>
    </div>

    <div class="menu-actions" aria-label="Menu actions">
      <ThemePicker id="mobile-theme-menu" placement="top-start" label="Theme" />
      <GitHubLink label="GitHub" />
    </div>
  </aside>
</header>

<script>
  const mobileMenuQuery = window.matchMedia("(max-width: 720px)");
  const menuOpenClass = "is-menu-open";
  const focusableMenuSelector =
    'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';

  type MenuElements = {
    header: HTMLElement;
    trigger: HTMLButtonElement;
    panel: HTMLElement;
  };

  const normalizePathname = (pathname: string) => {
    if (pathname === "" || pathname === "/") {
      return "/";
    }

    return pathname.replace(/\/$/, "");
  };

  const getMenuElements = () => {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    const trigger = header?.querySelector<HTMLButtonElement>("[data-menu-trigger]");
    const panel = header?.querySelector<HTMLElement>("[data-menu-panel]");

    if (!header || !trigger || !panel) {
      return null;
    }

    return { header, trigger, panel };
  };

  const getFocusableMenuElements = (elements: MenuElements) => {
    const panelElements = Array.from(
      elements.panel.querySelectorAll<HTMLElement>(focusableMenuSelector),
    );
    const focusableElements: HTMLElement[] = [elements.trigger, ...panelElements];

    return focusableElements.filter(
      (element) => element.tabIndex >= 0 && !element.closest("[hidden]"),
    );
  };

  const setNavigationMenuOpen = (open: boolean, restoreFocus = false) => {
    const elements = getMenuElements();

    if (!elements) {
      return;
    }

    const { header, trigger, panel } = elements;
    const shouldOpen = open && mobileMenuQuery.matches;

    header.classList.toggle(menuOpenClass, shouldOpen);
    trigger.setAttribute("aria-expanded", String(shouldOpen));
    trigger.setAttribute(
      "aria-label",
      shouldOpen ? "Close navigation menu" : "Open navigation menu",
    );

    if (shouldOpen) {
      panel.removeAttribute("inert");
    } else {
      panel.setAttribute("inert", "");
    }

    if (restoreFocus) {
      trigger.focus();
    }
  };

  const syncActiveNavigation = () => {
    const currentPath = normalizePathname(window.location.pathname);
    const links = document.querySelectorAll("[data-nav-link]");

    links.forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) {
        return;
      }

      const linkPath = normalizePathname(new URL(link.href).pathname);
      const isActive = linkPath === currentPath;

      link.classList.toggle("is-active", isActive);

      if (isActive && link.classList.contains("nav-link")) {
        link.setAttribute("aria-current", "page");
      } else {
        link.removeAttribute("aria-current");
      }
    });
  };

  const initializeNavigationMenu = () => {
    const header = document.querySelector<HTMLElement>("[data-site-header]");

    if (!header || header.dataset.menuInitialized === "true") {
      return;
    }

    const trigger = header.querySelector<HTMLButtonElement>("[data-menu-trigger]");
    const backdrop = header.querySelector<HTMLElement>("[data-menu-backdrop]");

    trigger?.addEventListener("click", () => {
      setNavigationMenuOpen(!header.classList.contains(menuOpenClass));
    });

    backdrop?.addEventListener("click", () => {
      setNavigationMenuOpen(false, true);
    });

    header.addEventListener("click", (event) => {
      const target = event.target;

      if (target instanceof HTMLAnchorElement && target.matches("[data-menu-link]")) {
        setNavigationMenuOpen(false, true);
      }
    });

    header.dataset.menuInitialized = "true";
    setNavigationMenuOpen(false);
  };

  syncActiveNavigation();
  initializeNavigationMenu();

  if (document.documentElement.dataset.tobHeaderSync !== "true") {
    document.addEventListener("keydown", (event) => {
      const elements = getMenuElements();

      if (!elements || !elements.header.classList.contains(menuOpenClass)) {
        return;
      }

      if (event.key === "Escape") {
        event.preventDefault();
        setNavigationMenuOpen(false, true);
        return;
      }

      if (event.key !== "Tab") {
        return;
      }

      const focusableElements = getFocusableMenuElements(elements);
      const firstElement = focusableElements[0];
      const lastElement = focusableElements[focusableElements.length - 1];

      if (!firstElement || !lastElement) {
        event.preventDefault();
        elements.trigger.focus();
        return;
      }

      const activeElement = document.activeElement;

      if (
        !(activeElement instanceof HTMLElement) ||
        !focusableElements.includes(activeElement)
      ) {
        event.preventDefault();
        firstElement.focus();
        return;
      }

      if (event.shiftKey && activeElement === firstElement) {
        event.preventDefault();
        lastElement.focus();
      } else if (!event.shiftKey && activeElement === lastElement) {
        event.preventDefault();
        firstElement.focus();
      }
    });

    mobileMenuQuery.addEventListener("change", (event) => {
      if (!event.matches) {
        setNavigationMenuOpen(false);
      }
    });

    document.addEventListener("astro:page-load", () => {
      initializeNavigationMenu();
      syncActiveNavigation();
      setNavigationMenuOpen(false);
    });

    document.documentElement.dataset.tobHeaderSync = "true";
  }
</script>

<style>
  .site-header {
    --menu-fade-duration: 220ms;
    --menu-slide-duration: 500ms;
    --menu-slide-easing: cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 0 0 var(--header-height);
    height: var(--header-height);
    min-height: var(--header-height);
    padding: 0 20px;
    border-bottom: 1px solid var(--line);
    background: var(--header-bg);
    color: var(--text-strong);
    isolation: isolate;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    gap: 8px;
    color: inherit;
    text-decoration: none;
    user-select: none;
  }

  .brand-link:focus-visible,
  .menu-trigger:focus-visible,
  .nav-link:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    color: inherit;
  }

  .brand-name {
    font-weight: 600;
    font-size: 14px;
    letter-spacing: -0.2px;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    height: 100%;
    min-width: 0;
    margin-left: auto;
    overflow-x: auto;
  }

  .nav-link {
    color: inherit;
    font-size: 14px;
    font-weight: 400;
    opacity: 0.45;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      opacity 0.2s ease,
      background-color 0.2s ease;
    white-space: nowrap;
  }

  .desktop-nav .nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 32px;
    padding: 6px 14px;
    border-radius: 6px;
    background: transparent;
  }

  .desktop-nav .nav-link:hover,
  .desktop-nav .nav-link:active,
  .desktop-nav .nav-link:focus,
  .desktop-nav .nav-link:focus-visible,
  .desktop-nav .nav-link:focus-within,
  .desktop-nav .nav-link[aria-current="page"],
  .desktop-nav .nav-link.is-active {
    background: transparent;
    background-image: none;
    opacity: 0.85;
  }

  .nav-link.is-active {
    opacity: 1;
    font-weight: 600;
  }

  .header-actions {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: 8px;
    color: inherit;
  }

  .action-divider {
    width: 1px;
    height: 20px;
    margin: 0 8px 0 12px;
    background: var(--line-strong);
  }

  .menu-trigger,
  .menu-backdrop,
  .menu-panel {
    display: none;
  }

  .menu-trigger {
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-left: auto;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    opacity: 0.45;
    -webkit-tap-highlight-color: transparent;
    transition:
      opacity 0.2s ease,
      background-color 0.2s ease;
  }

  .hamburger-icon {
    position: relative;
    display: block;
    width: 18px;
    height: 14px;
  }

  .hamburger-line {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
    transition:
      opacity 160ms var(--menu-slide-easing),
      transform 220ms var(--menu-slide-easing);
  }

  .hamburger-line:nth-child(1) {
    top: 0;
  }

  .hamburger-line:nth-child(2) {
    top: 6px;
  }

  .hamburger-line:nth-child(3) {
    top: 12px;
  }

  .site-header.is-menu-open .hamburger-line:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .site-header.is-menu-open .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .site-header.is-menu-open .hamburger-line:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .menu-content {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .mobile-nav .nav-link {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: flex-start;
    min-height: 44px;
    padding: 10px 12px;
    border-radius: 8px;
    background: transparent;
  }

  .mobile-nav .nav-link:hover,
  .mobile-nav .nav-link:active,
  .mobile-nav .nav-link:focus,
  .mobile-nav .nav-link:focus-visible,
  .mobile-nav .nav-link:focus-within,
  .mobile-nav .nav-link[aria-current="page"],
  .mobile-nav .nav-link.is-active {
    background: var(--surface-hover);
    opacity: 1;
  }

  .menu-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    gap: 16px;
    margin-top: 18px;
    color: inherit;
  }

  @media (max-width: 720px) {
    .site-header {
      padding-inline: 12px;
    }

    .site-header.is-menu-open {
      z-index: 103;
    }

    .brand-link {
      margin-right: 8px;
    }

    .desktop-nav,
    .desktop-actions {
      display: none;
    }

    .menu-trigger {
      position: relative;
      z-index: 104;
      display: inline-flex;
    }

    .menu-trigger:hover,
    .menu-trigger:focus-visible {
      opacity: 0.85;
      background: transparent;
    }

    .menu-trigger[aria-expanded="true"] {
      opacity: 1;
    }

    .menu-backdrop {
      position: fixed;
      inset: 0;
      z-index: 101;
      display: block;
      visibility: hidden;
      background: rgb(0 0 0 / 0.28);
      opacity: 0;
      pointer-events: none;
      transition:
        opacity var(--menu-fade-duration) var(--menu-slide-easing),
        visibility 0s linear var(--menu-fade-duration);
    }

    .site-header.is-menu-open .menu-backdrop {
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
      transition: opacity var(--menu-fade-duration) var(--menu-slide-easing);
    }

    .menu-panel {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      z-index: 102;
      display: flex;
      width: min(340px, calc(100vw - 24px));
      flex-direction: column;
      padding: calc(var(--header-height) + 16px) 16px 16px;
      border-left: 1px solid var(--line);
      background: var(--header-bg);
      box-shadow: var(--popover-shadow);
      color: var(--text-strong);
      overflow: hidden;
      pointer-events: none;
      transform: translate3d(100%, 0, 0);
      transition:
        transform var(--menu-slide-duration) var(--menu-slide-easing),
        visibility 0s linear var(--menu-slide-duration);
      visibility: hidden;
      will-change: transform;
    }

    .site-header.is-menu-open .menu-panel {
      pointer-events: auto;
      transform: translate3d(0, 0, 0);
      transition: transform var(--menu-slide-duration) var(--menu-slide-easing);
      visibility: visible;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hamburger-line,
    .menu-backdrop,
    .menu-panel {
      transition: none;
    }
  }
</style>
