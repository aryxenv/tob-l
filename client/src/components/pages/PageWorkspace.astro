---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="page-workspace" aria-labelledby="workspace-title">
  <h1 id="workspace-title" class="visually-hidden">{title}</h1>
</section>

<style>
  .page-workspace {
    min-height: inherit;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
    padding: 0;
  }
</style>
