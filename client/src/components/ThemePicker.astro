      aria-hidden="true"
      width="18"
      height="18"
      viewBox="2 2 20 20"
      fill="currentColor"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path d="M12 2c.41 0 .75.34.75.75v1.5a.75.75 0 0 1-1.5 0v-1.5c0-.41.34-.75.75-.75Zm0 15a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0-1.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Zm9.25-2.75a.75.75 0 0 0 0-1.5h-1.5a.75.75 0 0 0 0 1.5h1.5ZM12 19c.41 0 .75.34.75.75v1.5a.75.75 0 0 1-1.5 0v-1.5c0-.41.34-.75.75-.75Zm-7.75-6.25a.75.75 0 0 0 0-1.5h-1.5a.75.75 0 0 0 0 1.5h1.5Zm-.03-8.53c.3-.3.77-.3 1.06 0l1.5 1.5a.75.75 0 0 1-1.06 1.06l-1.5-1.5a.75.75 0 0 1 0-1.06Zm1.06 15.56a.75.75 0 1 1-1.06-1.06l1.5-1.5a.75.75 0 1 1 1.06 1.06l-1.5 1.5Zm14.5-15.56a.75.75 0 0 0-1.06 0l-1.5 1.5a.75.75 0 0 0 1.06 1.06l1.5-1.5c.3-.3.3-.77 0-1.06Zm-1.06 15.56a.75.75 0 1 0 1.06-1.06l-1.5-1.5a.75.75 0 1 0-1.06 1.06l1.5 1.5Z" />
    </svg>
    <svg
      class="theme-trigger-icon theme-icon-dark"
      aria-hidden="true"
      width="18"
      height="18"
      viewBox="2 2 20 20"
      fill="currentColor"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path d="M20.03 17a10 10 0 0 1-16.9.68.75.75 0 0 1 .36-1.13c3.77-1.35 5.79-2.91 6.96-5.15 1.23-2.35 1.55-4.93.69-8.46A.75.75 0 0 1 11.9 2 10 10 0 0 1 20.03 17Zm-8.25-4.9c-1.25 2.39-3.31 4.1-6.82 5.5a8.49 8.49 0 0 0 13.77-1.35 8.5 8.5 0 0 0-5.9-12.63c.64 3.39.22 6.05-1.05 8.48Z" />
    </svg>
  </button>
  <div
    id="theme-menu"
    class="theme-menu"
    role="menu"
    aria-label="Choose theme"
    hidden
    data-theme-menu
  >
    <button
      class="theme-option"
      type="button"
      role="menuitemradio"
      aria-checked="true"
      data-theme-option="system"
    >
      <svg
        class="theme-option-icon"
        aria-hidden="true"
        width="18"
        height="18"
        viewBox="2 2 20 20"
        fill="currentColor"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M6.75 22a.75.75 0 0 1-.1-1.5H8.5V18H4.25c-1.2 0-2.17-.92-2.24-2.1L2 15.76V5.25c0-1.2.93-2.17 2.1-2.24L4.25 3h15.5c1.19 0 2.16.93 2.24 2.1v10.65c0 1.2-.92 2.17-2.09 2.25h-4.4v2.5h1.75a.75.75 0 0 1 .1 1.5H6.75ZM14 18h-4v2.5h4V18Zm5.75-13.5H4.25c-.38 0-.7.28-.74.65l-.01.1v10.5c0 .38.28.7.65.75h15.6c.38 0 .7-.28.74-.65V5.25c0-.38-.27-.7-.64-.74l-.1-.01Z" />
      </svg>
      <span>System</span>
    </button>
    <button
      class="theme-option"
      type="button"
      role="menuitemradio"
      aria-checked="false"
      data-theme-option="light"
    >
      <svg
        class="theme-option-icon"
        aria-hidden="true"
        width="18"
        height="18"
        viewBox="2 2 20 20"
        fill="currentColor"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M12 2c.41 0 .75.34.75.75v1.5a.75.75 0 0 1-1.5 0v-1.5c0-.41.34-.75.75-.75Zm0 15a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0-1.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Zm9.25-2.75a.75.75 0 0 0 0-1.5h-1.5a.75.75 0 0 0 0 1.5h1.5ZM12 19c.41 0 .75.34.75.75v1.5a.75.75 0 0 1-1.5 0v-1.5c0-.41.34-.75.75-.75Zm-7.75-6.25a.75.75 0 0 0 0-1.5h-1.5a.75.75 0 0 0 0 1.5h1.5Zm-.03-8.53c.3-.3.77-.3 1.06 0l1.5 1.5a.75.75 0 0 1-1.06 1.06l-1.5-1.5a.75.75 0 0 1 0-1.06Zm1.06 15.56a.75.75 0 1 1-1.06-1.06l1.5-1.5a.75.75 0 1 1 1.06 1.06l-1.5 1.5Zm14.5-15.56a.75.75 0 0 0-1.06 0l-1.5 1.5a.75.75 0 0 0 1.06 1.06l1.5-1.5c.3-.3.3-.77 0-1.06Zm-1.06 15.56a.75.75 0 1 0 1.06-1.06l-1.5-1.5a.75.75 0 1 0-1.06 1.06l1.5 1.5Z" />
      </svg>
      <span>Light</span>
    </button>
    <button
      class="theme-option"
      type="button"
      role="menuitemradio"
      aria-checked="false"
      data-theme-option="dark"
    >
      <svg
        class="theme-option-icon"
        aria-hidden="true"
        width="18"
        height="18"
        viewBox="2 2 20 20"
        fill="currentColor"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M20.03 17a10 10 0 0 1-16.9.68.75.75 0 0 1 .36-1.13c3.77-1.35 5.79-2.91 6.96-5.15 1.23-2.35 1.55-4.93.69-8.46A.75.75 0 0 1 11.9 2 10 10 0 0 1 20.03 17Zm-8.25-4.9c-1.25 2.39-3.31 4.1-6.82 5.5a8.49 8.49 0 0 0 13.77-1.35 8.5 8.5 0 0 0-5.9-12.63c.64 3.39.22 6.05-1.05 8.48Z" />
      </svg>
      <span>Dark</span>
    </button>
  </div>
</div>

<script>
  type ThemePreference = "light" | "dark" | "system";
  type ResolvedTheme = "light" | "dark";

  const themeStorageKey = "tob-l-theme";
  const themePreferences: ThemePreference[] = ["system", "light", "dark"];
  const themeMediaQuery = window.matchMedia("(prefers-color-scheme: dark)");

  const isThemePreference = (
    value: string | null | undefined,
  ): value is ThemePreference =>
    value !== null &&
    value !== undefined &&
    themePreferences.includes(value as ThemePreference);

  const getSystemTheme = (): ResolvedTheme =>
    themeMediaQuery.matches ? "dark" : "light";

  const syncThemeColorMeta = (
    resolvedTheme: ResolvedTheme,
    targetDocument: Document = document,
  ) => {
    const themeColor = resolvedTheme === "dark" ? "#000000" : "#ffffff";
    const meta = targetDocument.querySelector<HTMLMetaElement>(
      'meta[name="theme-color"]',
    );

    meta?.setAttribute("content", themeColor);
  };

  const resolveTheme = (preference: ThemePreference): ResolvedTheme =>
    preference === "system" ? getSystemTheme() : preference;

  const getPreferenceLabel = (preference: ThemePreference) => {
    switch (preference) {
      case "light":
        return "Light";
      case "dark":
        return "Dark";
      case "system":
        return "System";
    }
  };

  const readThemePreference = (): ThemePreference => {
    try {
      const storedPreference = window.localStorage.getItem(themeStorageKey);

      return isThemePreference(storedPreference) ? storedPreference : "system";
    } catch (error) {
      console.warn("TOB-L could not read the saved theme preference.", error);
      return "system";
    }
  };

  const saveThemePreference = (preference: ThemePreference) => {
    try {
      window.localStorage.setItem(themeStorageKey, preference);
    } catch (error) {
      console.warn("TOB-L could not save the theme preference.", error);
    }
  };

  const applyThemeAttributes = (
    preference: ThemePreference,
    root: HTMLElement = document.documentElement,
    targetDocument: Document = document,
  ): ResolvedTheme => {
    const resolvedTheme = resolveTheme(preference);

    root.dataset.theme = resolvedTheme;
    root.dataset.themePreference = preference;
    root.style.colorScheme = resolvedTheme;
    syncThemeColorMeta(resolvedTheme, targetDocument);

    return resolvedTheme;
  };

  const applyThemePreference = (preference: ThemePreference): ResolvedTheme =>
    applyThemeAttributes(preference);

  const closeThemeMenu = (restoreFocus = false) => {
    const trigger = document.querySelector<HTMLButtonElement>(
      "[data-theme-trigger]",
    );
    const menu = document.querySelector<HTMLElement>("[data-theme-menu]");

    if (!trigger || !menu) {
      return;
    }

    menu.hidden = true;
    trigger.setAttribute("aria-expanded", "false");

    if (restoreFocus) {
      trigger.focus();
    }
  };

  const openThemeMenu = () => {
    const trigger = document.querySelector<HTMLButtonElement>(
      "[data-theme-trigger]",
    );
    const menu = document.querySelector<HTMLElement>("[data-theme-menu]");
    const checkedOption = document.querySelector<HTMLButtonElement>(
      '[data-theme-option][aria-checked="true"]',
    );

    if (!trigger || !menu) {
      return;
    }

    menu.hidden = false;
    trigger.setAttribute("aria-expanded", "true");
    (checkedOption ?? menu.querySelector<HTMLButtonElement>("[data-theme-option]"))
      ?.focus();
  };

  const toggleThemeMenu = () => {
    const menu = document.querySelector<HTMLElement>("[data-theme-menu]");

    if (menu?.hidden === false) {
      closeThemeMenu();
    } else {
      openThemeMenu();
    }
  };

  const syncThemePicker = (
    preference: ThemePreference,
    resolvedTheme: ResolvedTheme,
  ) => {
    const trigger = document.querySelector<HTMLButtonElement>(
      "[data-theme-trigger]",
    );
    const options =
      document.querySelectorAll<HTMLButtonElement>("[data-theme-option]");
    const label = getPreferenceLabel(preference);

    trigger?.setAttribute(
      "aria-label",
      `Theme: ${label}${preference === "system" ? ` (currently ${getPreferenceLabel(resolvedTheme)})` : ""}`,
    );
    trigger?.setAttribute("title", `Theme: ${label}`);
    trigger?.setAttribute("data-theme-preference", preference);

    options.forEach((option) => {
      option.setAttribute(
        "aria-checked",
        option.dataset.themeOption === preference ? "true" : "false",
      );
      option.tabIndex = option.dataset.themeOption === preference ? 0 : -1;
    });
  };

  const setThemePreference = (preference: ThemePreference) => {
    saveThemePreference(preference);
    const resolvedTheme = applyThemePreference(preference);
    syncThemePicker(preference, resolvedTheme);
  };

  const focusThemeOption = (direction: "first" | "last" | "next" | "previous") => {
    const options = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-theme-option]"),
    );
    const activeIndex = options.findIndex(
      (option) => option === document.activeElement,
    );

    if (options.length === 0) {
      return;
    }

    const nextIndex =
      direction === "first"
        ? 0
        : direction === "last"
          ? options.length - 1
          : direction === "next"
            ? (activeIndex + 1) % options.length
            : (activeIndex - 1 + options.length) % options.length;

    options[nextIndex]?.focus();
  };

  const initializeThemePicker = () => {
    const picker = document.querySelector<HTMLElement>("[data-theme-picker]");
    const trigger = document.querySelector<HTMLButtonElement>(
      "[data-theme-trigger]",
    );
    const menu = document.querySelector<HTMLElement>("[data-theme-menu]");

    if (!picker || !trigger || !menu || picker.dataset.initialized === "true") {
      const preference = readThemePreference();
      syncThemePicker(preference, applyThemePreference(preference));
      return;
    }

    picker.dataset.initialized = "true";

    const preference = readThemePreference();
    setThemePreference(preference);

    trigger.addEventListener("click", toggleThemeMenu);
    trigger.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        toggleThemeMenu();
      } else if (event.key === "ArrowDown") {
        event.preventDefault();
        openThemeMenu();
      } else if (event.key === "Escape") {
        closeThemeMenu();
      }
    });

    menu.addEventListener("click", (event) => {
      const option = (event.target as Element).closest<HTMLButtonElement>(
        "[data-theme-option]",
      );

      if (!option || !isThemePreference(option.dataset.themeOption)) {
        return;
      }

      setThemePreference(option.dataset.themeOption);
      closeThemeMenu(true);
    });

    menu.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        event.preventDefault();
        closeThemeMenu(true);
      } else if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        (document.activeElement as HTMLElement | null)?.click();
      } else if (event.key === "ArrowDown") {
        event.preventDefault();
        focusThemeOption("next");
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        focusThemeOption("previous");
      } else if (event.key === "Home") {
        event.preventDefault();
        focusThemeOption("first");
      } else if (event.key === "End") {
        event.preventDefault();
        focusThemeOption("last");
      }
    });
  };

  initializeThemePicker();

  if (document.documentElement.dataset.tobThemePicker !== "true") {
    themeMediaQuery.addEventListener("change", () => {
      const preference = readThemePreference();

      if (preference === "system") {
        syncThemePicker(preference, applyThemePreference(preference));
      }
    });

    document.addEventListener("click", (event) => {
      const picker = document.querySelector<HTMLElement>("[data-theme-picker]");

      if (picker && !picker.contains(event.target as Node)) {
        closeThemeMenu();
      }
    });

    document.addEventListener("astro:page-load", initializeThemePicker);
    document.addEventListener("astro:before-swap", (event) => {
      closeThemeMenu();

      const newDocument = (event as Event & { newDocument?: Document })
        .newDocument;

      if (newDocument) {
        const preference = readThemePreference();
        applyThemeAttributes(
          preference,
          newDocument.documentElement,
          newDocument,
        );
      }
    });
    document.documentElement.dataset.tobThemePicker = "true";
  }
</script>

<style>
  .theme-picker {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .theme-trigger,
  .theme-option {
    border: 0;
    background: transparent;
    background-image: none;
    color: inherit;
    font: inherit;
    -webkit-tap-highlight-color: transparent;
  }

  .theme-trigger {
    position: relative;
    display: inline-flex;
    width: 32px;
    min-width: 32px;
    height: 32px;
    align-items: center;
    justify-content: center;
    padding: 0;
    border-radius: 6px;
    opacity: 0.45;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .theme-trigger:hover,
  .theme-trigger:active,
  .theme-trigger:focus-visible,
  .theme-trigger[aria-expanded="true"] {
    opacity: 0.85;
    background: transparent;
    background-image: none;
  }

  .theme-trigger:focus-visible,
  .theme-option:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .theme-trigger-icon {
    display: none;
    width: 18px;
    height: 18px;
  }

  .theme-trigger:not([data-theme-preference]) .theme-icon-system,
  .theme-trigger[data-theme-preference="system"] .theme-icon-system,
  .theme-trigger[data-theme-preference="light"] .theme-icon-light,
  .theme-trigger[data-theme-preference="dark"] .theme-icon-dark {
    display: block;
  }

  .theme-menu {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    z-index: 101;
    min-width: 128px;
    padding: 6px;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--header-bg);
    color: var(--text-strong);
    box-shadow: var(--popover-shadow);
  }

  .theme-menu:not([hidden]) {
    animation: theme-menu-fade 140ms ease-out;
  }

  .theme-menu[hidden] {
    display: none;
  }

  @keyframes theme-menu-fade {
    from {
      opacity: 0;
      transform: translateY(-2px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .theme-option {
    position: relative;
    display: flex;
    width: 100%;
    align-items: center;
    gap: 8px;
    min-height: 32px;
    padding: 6px 28px 6px 10px;
    border-radius: 6px;
    font-size: 13px;
    line-height: 1.25;
    text-align: left;
    cursor: pointer;
  }

  .theme-option-icon {
    flex: 0 0 18px;
    width: 18px;
    height: 18px;
  }

  .theme-option:hover,
  .theme-option:focus-visible {
    background: var(--surface-hover);
  }

  .theme-option[aria-checked="true"]::after {
    position: absolute;
    right: 10px;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: currentColor;
    content: "";
    line-height: 1;
  }
</style>
