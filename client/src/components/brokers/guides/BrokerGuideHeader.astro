---
import type { CollectionEntry } from "astro:content";
import { getBrokerLogoSrc } from "../brokerGuides";

interface Props {
  guide: CollectionEntry<"brokerGuides">;
}

const { guide } = Astro.props;
const logoSrc = getBrokerLogoSrc(guide.id, guide.data.logoSrc);
---

<header class="guide-header">
  <img class="broker-logo" src={logoSrc} alt="" loading="lazy" aria-hidden="true" />
  <div class="header-copy">
    <h1 id="broker-guide-title">{guide.data.name}</h1>
  </div>
</header>

<style>
  .guide-header {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .broker-logo {
    display: block;
    width: 72px;
    height: 72px;
    flex: 0 0 72px;
    filter: var(--broker-logo-filter);
    object-fit: contain;
  }

  .header-copy {
    display: grid;
    gap: var(--space-2);
  }

  .eyebrow {
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  h1 {
    color: var(--text-strong);
    font-size: clamp(2.25rem, 7vw, 4.75rem);
    font-weight: 700;
    letter-spacing: -0.08em;
    line-height: 0.95;
  }

  @media (max-width: 560px) {
    .guide-header {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
