---
import ThemeMenu from "./ThemeMenu";
import { TABS } from "../constants";

import type { TabValue } from "../types";

interface Props {
  activeNav: TabValue;
}

const { activeNav } = Astro.props;
---

<header class="site-header">
  <a
    class:list={["brand-link", activeNav === "calculate" && "is-active"]}
    data-nav-link
    href="/"
  >
    <span class="brand-mark" aria-hidden="true">
      <svg
        height="20"
        viewBox="0 0 20 20"
        width="20"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M3.5 3.5h13v3h-5v10h-3v-10h-5v-3Z"
          fill="currentColor"
        />
      </svg>
    </span>
    <span class="brand-name">TOB-L</span>
  </a>

  <nav class="primary-nav" aria-label="Primary">
    {TABS.map((tab) => (
      <a
        class:list={["nav-link", activeNav === tab.value && "is-active"]}
        data-nav-link
        href={tab.href}
        aria-current={activeNav === tab.value ? "page" : undefined}
      >
        {tab.label}
      </a>
    ))}
  </nav>

  <div class="header-actions" aria-label="Header actions">
    <div class="action-divider" aria-hidden="true"></div>
    <div class="theme-action">
      <ThemeMenu client:only="react" />
    </div>
    <a
      class="icon-link"
      href="https://github.com/aryxenv/tob-l"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Open TOB-L on GitHub"
      title="GitHub"
    >
      <svg
        aria-hidden="true"
        width="18"
        height="18"
        viewBox="0 0 16 16"
        fill="currentColor"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
      </svg>
    </a>
  </div>
</header>

<script>
  const normalizePathname = (pathname) => {
    if (pathname === "" || pathname === "/") {
      return "/";
    }

    return pathname.replace(/\/$/, "");
  };

  const syncActiveNavigation = () => {
    const currentPath = normalizePathname(window.location.pathname);
    const links = document.querySelectorAll("[data-nav-link]");

    links.forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) {
        return;
      }

      const linkPath = normalizePathname(new URL(link.href).pathname);
      const isActive = linkPath === currentPath;

      link.classList.toggle("is-active", isActive);

      if (isActive && link.classList.contains("nav-link")) {
        link.setAttribute("aria-current", "page");
      } else {
        link.removeAttribute("aria-current");
      }
    });
  };

  syncActiveNavigation();

  if (document.documentElement.dataset.tobNavSync !== "true") {
    document.addEventListener("astro:page-load", syncActiveNavigation);
    document.documentElement.dataset.tobNavSync = "true";
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    padding: 0 20px;
    border-bottom: 1px solid var(--line);
    background: #000;
    color: #fefefe;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    gap: 8px;
    color: inherit;
    text-decoration: none;
    user-select: none;
  }

  .brand-link:focus-visible,
  .nav-link:focus-visible,
  .icon-link:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .brand-mark {
    display: inline-flex;
    align-items: center;
    color: inherit;
  }

  .brand-name {
    font-weight: 600;
    font-size: 14px;
    letter-spacing: -0.2px;
  }

  .primary-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    height: 100%;
    min-width: 0;
    margin-left: auto;
    overflow-x: auto;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 32px;
    padding: 6px 14px;
    border-radius: 6px;
    color: inherit;
    font-size: 14px;
    font-weight: 400;
    opacity: 0.45;
    text-decoration: none;
    transition:
      opacity 0.2s ease,
      background-color 0.2s ease;
    white-space: nowrap;
  }

  .nav-link:hover,
  .nav-link.is-active {
    opacity: 0.85;
    background: var(--surface-hover);
  }

  .nav-link.is-active {
    opacity: 1;
    font-weight: 600;
  }

  .header-actions {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: 4px;
    margin-left: 8px;
    color: inherit;
  }

  .action-divider {
    width: 1px;
    height: 20px;
    margin: 0 4px 0 8px;
    background: var(--line-strong);
  }

  .theme-action {
    display: inline-flex;
    width: 32px;
    height: 32px;
    align-items: center;
    justify-content: center;
  }

  .theme-action :global(.fui-Button) {
    width: 32px;
    min-width: 32px;
    height: 32px;
    color: inherit;
    opacity: 0.45;
    transition:
      opacity 0.2s ease,
      background-color 0.2s ease;
  }

  .theme-action :global(.fui-Button:hover) {
    opacity: 0.85;
    background: var(--surface-hover);
  }

  .icon-link {
    display: inline-flex;
    width: 32px;
    height: 32px;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    color: inherit;
    opacity: 0.45;
    text-decoration: none;
    transition:
      opacity 0.2s ease,
      background-color 0.2s ease;
  }

  .icon-link:hover {
    opacity: 0.85;
    background: var(--surface-hover);
  }

  @media (max-width: 720px) {
    .site-header {
      padding-inline: 12px;
    }

    .brand-link {
      margin-right: 8px;
    }

    .primary-nav {
      justify-content: flex-start;
    }

    .nav-link {
      padding-inline: 10px;
    }
  }
</style>
